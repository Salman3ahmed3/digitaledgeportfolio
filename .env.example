# -----------------------------------------------------------------------------
# Digital Edge — environment variables
# Copy this file to `.env.local` and fill in real values, then restart `dev`.
# All NEXT_PUBLIC_* vars are exposed to the browser (that's expected for pixels).
# -----------------------------------------------------------------------------

# Google Tag Manager container ID (e.g. GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_ID=

# Meta (Facebook) Pixel ID (e.g. 000000000000000)
NEXT_PUBLIC_META_PIXEL_ID=
